[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
ignoreip = 127.0.0.1/8

[sshd]
enabled = true
port = ssh
logpath = /var/log/auth.log

[postfix]
enabled = true
port = smtp,submission
logpath = /var/log/mail.log

[dovecot]
enabled = true
port = pop3,imap,submission,pop3s,imaps
logpath = /var/log/mail.log
