# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your deployment environment.
# ==============================================================================

# Domain & Server Config
DOMAIN=example.com
MAIL_HOST=mail.example.com
AUDIT_BCC_EMAIL=audit@example.com
DEFAULT_WIKI_URL=https://notion.so/your-wiki-link

# Brevo API & SMTP Credentials
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_USER=your_brevo_smtp_user_here
BREVO_SMTP_PASS=your_brevo_smtp_pass_here
BREVO_SEND_SCRIPT=/usr/local/bin/brevo-send.py

# Mail Admin Settings
SAFE_MODE=true
DEFAULT_NEW_USER_QUOTA_MB=512
QUOTA_POLICY_FILE=/root/mail-quota-policy.json
POSTFIX_VIRTUAL_FILE=/etc/postfix/virtual
LE_CERT_FULLCHAIN=/etc/letsencrypt/live/mail.example.com/fullchain.pem
MAIL_LOG_FILE=/var/log/mail.log
